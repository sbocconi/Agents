# Use a slim Node image as the base
# https://oneuptime.com/blog/post/2026-02-08-how-to-check-the-os-and-architecture-of-a-docker-image/view
# docker manifest inspect arm64v8/node:26-slim
FROM arm64v8/node:26-slim

ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-pip git curl zstd ruby bundler ruby-dev procps

# Install Node.js 22.x and npm
RUN apt remove -y nodejs npm 
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
RUN apt install -y nodejs

# remove apt lists to reduce image size
RUN rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Install the Agent platforms
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN ln -s /root/.local/bin/claude /usr/local/bin/
RUN curl -fsSL https://opencode.ai/install | bash
RUN ln -s /root/.opencode/bin/opencode /usr/local/bin/
RUN npm install -g @openai/codex
RUN npm install -g @github/copilot
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
RUN ln -s /root/.local/bin/uv* /usr/local/bin/
# Tell uv to use copies instead of hardlinks
ENV UV_LINK_MODE=copy

# RUN echo 'export PATH="/root/.local/bin:$PATH"' >> /root/.bashrc
# Workspace directory is set in docker run

# Keep the container running
CMD ["sleep", "infinity"]